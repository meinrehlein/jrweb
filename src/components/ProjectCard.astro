---
import type { CollectionEntry } from "astro:content";
import { marked } from "marked";

type Props = { project: CollectionEntry<"projects"> };
const { project } = Astro.props as Props;

const aspectRatio = project.data.aspectRatio ?? "1 / 1.417";
const bodyDE = (project.data.body ?? project.body ?? "").toString();
const bodyEN = (project.data.body_en ?? "").toString();

// Always use filename (slug) for name
const nameFromFile = project.slug;
const title = project.data.title ?? nameFromFile;
const videoUrl = project.data.video
  ? project.data.video.includes('://')
    ? project.data.video
    : `https://stream.mux.com/${project.data.video}.m3u8`
  : "";
---

<div
  class="project"
  style={`--image:url('${project.data.images?.[0]?.src ?? ""}'); --rect-aspect:${aspectRatio}`}
  data-name={nameFromFile}
  aria-label={title}
>
  {project.data.kind === "text" && (
    <>
      <div class="titlebox">
        <p>{title}</p>
      </div>
      <div class="rectangle-content">
          <div class="lang-de" set:html={marked(bodyDE)}></div>
          <div class="lang-en" set:html={marked(bodyEN || bodyDE)}></div>
      </div>
    </>
  )}

{project.data.kind === "video" && project.data.video && (
  <div class="video-wrapper">
    <video
      class="project-video"
      muted
      preload="none"
      playsinline
      loop
      poster={`https://image.mux.com/${project.data.video}/thumbnail.png?time=${project.data.startTime ?? 0}`}
      data-start-time={project.data.startTime}
      data-hls={videoUrl}
      data-max-height="480"
      max-resolution="480p"
    ></video>
    <button class="mute-toggle" aria-label="Toggle sound">unmute</button>
  </div>
)}




