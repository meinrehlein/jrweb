---
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";

import { SEO } from "astro-seo";

import SmoothScroll from "../components/SmoothScroll.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "@fontsource/open-sans/400.css";
import openSansWoff2 from "@fontsource/open-sans/files/open-sans-latin-400-normal.woff2";

type Props = {
  title: string;
  description?: string;
};

const { title, description = "Jannis Reinelt" } = Astro.props;

// Current page value (/home, /about, /404 ...)
const currentPage =
  Astro.url.pathname.replace(/\/$/, "").split("/").pop() || "home";
---

<!doctype html>
<html lang="en" data-page={currentPage}>
  <head>
    <SEO
      title={title}
      description={description}
      charset="UTF-8"
      extend={{
        link: [
          { rel: "icon", type: "image/png", sizes: "96x96", href: "/favicon/favicon-96x96.png" },
          { rel: "icon", type: "image/svg+xml", href: "/favicon/favicon.svg" },
          { rel: "shortcut icon", href: "/favicon/favicon.ico" },
          { rel: "apple-touch-icon", sizes: "180x180", href: "/favicon/apple-touch-icon.png" },
          { rel: "manifest", href: "/favicon/site.webmanifest" },
          { rel: "preload", href: openSansWoff2, as: "font", type: "font/woff2", crossorigin: "anonymous" },
        ],
        meta: [
          { name: "apple-mobile-web-app-title", content: "MyWebSite" },
          { name: "viewport", content: "width=device-width" },
          { name: "msapplication-TileColor", content: "#000000" },
          { name: "theme-color", content: "#ffffff" },
          { name: "generator", content: Astro.generator },
        ],
      }}
    />
    <ClientRouter />
  </head>
  <body>
    <SmoothScroll />
    <Header />
    <slot />
<!-- BaseLayout.astro — just before </body> -->
<script src={`/scripts/initVideo.js?v=${Date.now()}`} type="module" is:inline></script>
<script id="hlsjs" src="https://cdn.jsdelivr.net/npm/hls.js@1.5.11/dist/hls.min.js" defer></script>
<script src="/scripts/themeToggle.js" type="module" is:inline></script>
<script src="/scripts/langToggle.js" type="module" is:inline></script>
<script src="/scripts/videoAutoPlay.js" type="module" is:inline></script>
<script src="/scripts/mailcopy.js" type="module" is:inline></script>

 <Footer/>
  </body>
 
</html>
