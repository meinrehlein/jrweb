---
const res = await fetch('/api/hvv');
const { data } = await res.json();
---

<html>
  <head>
    <meta charset="utf-8" />
    <title>HVV Abfahrten</title>
    <style>
      body { background:#000; color:#0f0; font-family:monospace; padding:1rem; }
      .delay { color:red; }
    </style>
  </head>
  <body>
    <h1>🚏 Abfahrten</h1>

    <ul>
      {data.map(d => (
        <li>
          <b>{d.linie}</b> → {d.richtung}
          ({d.halte})<br>

          🕒 {new Date(d.abfahrt).toLocaleTimeString("de-DE", {hour:"2-digit", minute:"2-digit"})}
          {d.delay > 0 && <span class="delay"> +{d.delay}</span>}
        </li>
      ))}
    </ul>
  </body>
</html>
