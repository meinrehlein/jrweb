---
const base = import.meta.env.SITE || 'http://localhost:4321';
const res = await fetch(`${base}/api/hvv`);
const json = await res.json();
const departures = json.data || [];
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Abfahrten HVV (Grevenweg & Burgstraße)</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #000;
        color: #0f0;
        padding: 1rem;
        font-size: 1.4rem;
      }
      li { margin-bottom: 0.5rem; }
      .linie { font-weight: bold; }
      .delay { color: red; margin-left: 0.4rem; }
    </style>
  </head>
  <body>
    <h1>🚏 HVV Abfahrten (Grevenweg & Burgstraße)</h1>
    <ul>
      {departures.length > 0 ? (
        departures.map(dep => (
          <li>
            <span class="linie">{dep.linie}</span> → {dep.richtung}<br/>
            🕓 {dep.abfahrt}
          </li>
        ))
      ) : (
        <p>Keine Daten verfügbar oder HVV blockiert den direkten Zugriff.</p>
      )}
    </ul>

    <!-- Reload alle 30 Sekunden -->
    <script>
      setTimeout(() => location.reload(), 30000);
    </script>
  </body>
</html>
