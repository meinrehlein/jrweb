---
/* No npm imports needed — everything runs in the browser */
const MQTT_URL = "wss://b0c07e39dc5f44fa9b25d42a4a0b3dae.s1.eu.hivemq.cloud:8884/mqtt";
const MQTT_USER = "avatar";      // ← replace
const MQTT_PASS = "Blauermensch2025";      // ← replace
const MQTT_TOPIC = "streamcontrol/actions";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stream Control</title>

    <style>
      html, body {
        margin: 0; padding: 0; height: 100%;
        background: #000; color: #fff;
        font-family: system-ui, sans-serif;
        display: flex; flex-direction: column;
      }
      button {
        flex: 1; width: 100%; font-size: 2rem;
        border: none; cursor: pointer;
        color: white; transition: 0.2s;
      }
      button:nth-child(1){background:#2ecc71;}
      button:nth-child(2){background:#e74c3c;}
      button:nth-child(3){background:#3498db;}
      button:nth-child(4){background:#9b59b6;}
      button:nth-child(5){background:#f1c40f;color:#222;}
      button:active {filter: brightness(0.7);}
    </style>
  </head>

  <body>
    <button data-msg="erledigt">Erledigt</button>
    <button data-msg="abgebrochen">Abgebrochen</button>
    <button data-msg="öffnen">Öffnen</button>
    <button data-msg="schließen">Schließen</button>
    <button data-msg="inventar">Inventar</button>

    <script type="module">
      import mqtt from "https://unpkg.com/mqtt@5.10.0/dist/mqtt.min.mjs";

      // Connect to HiveMQ Cloud via WebSocket
      const client = mqtt.connect("${MQTT_URL}", {
        username: "${MQTT_USER}",
        password: "${MQTT_PASS}",
        clean: true,
        connectTimeout: 4000,
        reconnectPeriod: 2000,
      });

      client.on("connect", () => {
        console.log("✅ Connected to HiveMQ Cloud via WebSocket");
      });

      client.on("error", (err) => {
        console.error("❌ MQTT error:", err);
      });

      document.querySelectorAll("button").forEach((btn) => {
        btn.addEventListener("click", () => {
          const msg = btn.dataset.msg;
          client.publish("${MQTT_TOPIC}", msg);
          console.log("📤 Sent:", msg);
        });
      });
    </script>
  </body>
</html>
