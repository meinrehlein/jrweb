---
const MQTT_URL = "wss://b0c07e39dc5f44fa9b25d42a4a0b3dae.s1.eu.hivemq.cloud:8884/mqtt";
const MQTT_USERNAME = "avatar";
const MQTT_PASSWORD = "Blauermensch2025";
const MQTT_TOPIC = "streamcontrol/actions";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Stream Control</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      html, body {
        margin: 0; padding: 0; height: 100%;
        background: #000; color: #fff;
        display: flex; flex-direction: column;
        font-family: system-ui, sans-serif;
      }
      button {
        flex: 1; width: 100%; font-size: 2rem;
        border: none; cursor: pointer;
        color: white; transition: 0.2s;
      }
      button:nth-child(1){background:#2ecc71;}
      button:nth-child(2){background:#e74c3c;}
      button:nth-child(3){background:#3498db;}
      button:nth-child(4){background:#9b59b6;}
      button:nth-child(5){background:#f1c40f;color:#000;}
    </style>
  </head>
  <body>
    <button data-msg="erledigt">Erledigt</button>
    <button data-msg="abgebrochen">Abgebrochen</button>
    <button data-msg="öffnen">Öffnen</button>
    <button data-msg="schließen">Schließen</button>
    <button data-msg="inventar">Inventar</button>

    <!-- load local UMD build (same-origin) -->
    <script id="mqtt-umd" src="/vendor/mqtt.min.js"></script>

    <script type="module">
      // inject frontmatter values (Astro renders these into the page)
      const MQTT_URL = {JSON.stringify(MQTT_URL)};
      const MQTT_USERNAME = {JSON.stringify(MQTT_USERNAME)};
      const MQTT_PASSWORD = {JSON.stringify(MQTT_PASSWORD)};
      const MQTT_TOPIC = {JSON.stringify(MQTT_TOPIC)};

      // wait for UMD to load and then use window.mqtt
      const mqtt = await new Promise(resolve => {
        if (window.mqtt) return resolve(window.mqtt);
        const s = document.getElementById('mqtt-umd');
        if (!s) return resolve(null);
        s.addEventListener('load', () => resolve(window.mqtt));
        s.addEventListener('error', () => resolve(null));
      });

      if (!mqtt) {
        console.error("mqtt not available on window — check /vendor/mqtt.min.js");
        document.querySelectorAll("button").forEach(b => b.disabled = true);
        throw new Error("mqtt missing");
      }

      const client = mqtt.connect(MQTT_URL, {
        username: MQTT_USERNAME,
        password: MQTT_PASSWORD,
        clean: true,
        connectTimeout: 4000,
        reconnectPeriod: 2000,
      });

      client.on("connect", () => console.log("✅ Connected"));
      client.on("error", (err) => console.error("MQTT error:", err));

      document.querySelectorAll("button").forEach(btn =>
        btn.addEventListener("click", () => {
          const msg = btn.dataset.msg;
          client.publish(MQTT_TOPIC, msg);
          console.log("📤 Sent:", msg);
        })
      );
    </script>
  </body>
</html>
