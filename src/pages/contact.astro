---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Jannis Reinelt - Contact";
---
<BaseLayout title={title}>
  <main class="contact-page">
    <div class="word">
       <p>
    <span class="lang-de">klick:</span>
    <span class="lang-en">click:</span>
  </p>

  <a id="mail">hi@jannisreinelt.com</a>

  <p class="spacer">
    <span class="lang-de">oder:</span>
    <span class="lang-en">or:</span>
  </p>
      <!-- Netlify form -->
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p class="sr-only">
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>

        <label for="name">
          <span class="lang-de">Name</span>
          <span class="lang-en">Name</span>
        </label>
        <input id="name" name="name" type="text" autocomplete="name" required />

        <label for="email">
          <span class="lang-de">E-Mail</span>
          <span class="lang-en">Email</span>
        </label>
        <input id="email" name="email" type="email" autocomplete="email" required />

        <label for="message">
          <span class="lang-de">Nachricht</span>
          <span class="lang-en">Message</span>
        </label>
        <textarea id="message" name="message" rows="6" placeholder="..." required></textarea>

        <button type="submit">
          <span class="lang-de">Senden</span>
          <span class="lang-en">Send</span>
        </button>
      </form>

      <!-- Copy-to-clipboard JS -->
      <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
          const textToCopy = document.getElementById('mail');
          textToCopy?.addEventListener('click', function () {
            copyText(this);
          });
        });

        function copyText(element) {
          const text = element.textContent || '';
          if (navigator.clipboard) {
            navigator.clipboard
              .writeText(text)
              .then(() => {
                alert(`Copied to clipboard: "${text}"`);
              })
              .catch((err) => {
                console.error('Failed to copy text:', err);
              });
          } else {
            alert('Clipboard API not supported in your browser.');
          }
        }
      </script>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-page {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 87vh;
    font-size: var(--font-size-m);
    /* text-decoration-line: underline; */
    text-decoration-skip-ink: auto;   /* nicer over descenders */
    text-underline-offset: 0.08em;    /* small gap from text */
    text-decoration-thickness: from-font;
    
  }
.spacer {
  margin-top: 1.5rem; /* extra space before "or:" */
}
  .word {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(90vw, 40rem);
  }

  .word label {
    font-size: var(--font-size-s);
    color: var(--color-text-alt);
    text-decoration: none;
  }

  .word input[type="text"],
  .word input[type="email"] {
    width: 100%;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem;
  }

  .word textarea {
    width: 100%;
    min-height: 10rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem;
    resize: vertical;
  }

  .word button[type="submit"] {
    align-self: flex-start;
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.8rem;
    text-decoration: none;
  }
</style>
