---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Jannis Reinelt - Contact";
---
<BaseLayout title={title}>
  <main class="contact-page">
    <section class="project-grid" id="grid" data-grid="projects">
      <!-- Card 1 -->
      <div class="project">
        <div class="rectangle-content">
          <p><span class="lang-de">klick:</span> <span class="lang-en">click:</span></p>
          <a id="mail" class="email-text">hi@jannisreinelt.com</a>
        </div>
      </div>

      <!-- Card 2 (form card) -->
      <div class="contact-card">
        <div class="word">
          <p class="spacer"><span class="lang-de">oder:</span> <span class="lang-en">or:</span></p>

          <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <p class="sr-only">
              <label>Don’t fill this out: <input name="bot-field" /></label>
            </p>

            <label for="name"><span class="lang-de">Name</span><span class="lang-en">Name</span></label>
            <input id="name" name="name" type="text" autocomplete="name" />

            <label for="email"><span class="lang-de">E-Mail*</span><span class="lang-en">Email*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />

            <label for="message"><span class="lang-de">Nachricht</span><span class="lang-en">Message</span></label>
            <textarea id="message" name="message" rows="6" placeholder="..." required></textarea>

            <button type="submit"><span class="lang-de">Senden</span><span class="lang-en">Send</span></button>
          </form>
        </div>
      </div>
    </section>

    <!-- Auto-resize textarea (grow + shrink) -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const ta = document.getElementById("message");
        if (!ta) return;
        const resize = () => {
          ta.style.height = "auto";
          ta.style.height = ta.scrollHeight + "px";
        };
        ta.addEventListener("input", resize);
        resize();
      });
    </script>
  </main>
</BaseLayout>

<style>
  /* Layout around the grid */
  .contact-page {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: 5rem;
    min-height: 60vh;
    font-size: var(--font-size-m);
    text-decoration-skip-ink: auto;
    text-underline-offset: 0.08em;
    text-decoration-thickness: from-font;
  }

  /* --- Grid --- */
  .project-grid {
    position: relative;
    overflow: visible;
    display: grid;
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
    --rect-width: 26.1rem;
    grid-template-columns: repeat(auto-fill, var(--rect-width));
    grid-auto-rows: auto;       /* <-- ensure rows grow with content */
    align-items: start;         /* no stretching that could mask growth */
    gap: 1rem;
    justify-content: center;
    margin-top: 5rem;
    margin-bottom: 2rem;
    min-height: 70vh;
  }

  @media (max-width: 50em) {
    .project-grid {
      --rect-width: 100%;
      margin-top: 2rem;
      grid-template-columns: 1fr;
      width: 96vw;
    }
  }

  /* Cards */
  .contact-card {
    border: 1px solid var(--border-color, #e5e5e5);
    background: var(--color-bg, #fff);
    display: grid;
    grid-template-rows: auto 1fr; /* title then content that grows */
    height: auto;                 /* <-- allow card to grow */
    overflow: visible;            /* <-- let inner growth show */
    align-self: start;            /* <-- avoid grid stretching tricks */
  }

  .titlebox { padding: .75rem; border-bottom: 1px solid var(--border-color, #e5e5e5); }
  .titlebox p { margin: 0; font-weight: 600; }

  .word {
    display: grid;         /* use grid so inner fields stack nicely */
    gap: 0.75rem;
    width: 100%;
    padding: 1rem;
    box-sizing: border-box;
  }

  .spacer { margin-top: 0.5rem; }

  .email-text { user-select: all; width: fit-content; padding: 0.15rem 0; }

  /* Inputs */
  label { font-size: var(--font-size-s); color: var(--color-text-alt); }
  input[type="text"], input[type="email"], textarea {
    width: 100%;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem;
    box-sizing: border-box;
  }

  /* Textarea auto-resize visuals */
  textarea {
    min-height: 20rem;
    resize: none;          /* JS handles growth/shrink */
    overflow: hidden;      /* no scrollbar */
    transition: height 0.2s ease;
  }

  button[type="submit"] {
    justify-self: start;
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.8rem;
    margin: 0.5rem 0 0;
    background: transparent;
    cursor: pointer;
  }

  .sr-only { position: absolute; left: -9999px; }
</style>
