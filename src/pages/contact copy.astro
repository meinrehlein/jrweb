---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Jannis Reinelt - Contact";
---
<BaseLayout title={title}>
  <main class="contact-page">
    <div class="word">
      <!-- Labels above the email in DE/EN -->
      <p>
        <span class="lang-de">klick:</span>
        <span class="lang-en">click:</span>
      </p>

      <!-- Plain text email (click copies to clipboard; no mailto) -->
      <a id="mail" class="email-text">hi@jannisreinelt.com</a>

      <!-- Spacer + 'or' in DE/EN -->
      <p class="spacer">
        <span class="lang-de">oder:</span>
        <span class="lang-en">or:</span>
      </p>

      <!-- Netlify form -->
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p class="sr-only">
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>

        <label for="name">
          <span class="lang-de">Name</span>
          <span class="lang-en">Name</span>
        </label>
        <input id="name" name="name" type="text" autocomplete="name" />

        <label for="email">
          <span class="lang-de">E-Mail*</span>
          <span class="lang-en">Email*</span>
        </label>
        <input id="email" name="email" type="email" autocomplete="email" required />

        <label for="message">
          <span class="lang-de">Nachricht</span>
          <span class="lang-en">Message</span>
        </label>
        <textarea id="message" name="message" rows="6" placeholder="..." required></textarea>

        <button type="submit">
          <span class="lang-de">Senden</span>
          <span class="lang-en">Send</span>
        </button>
      </form>

      <script is:inline>
  function initTextareaResize() {
    const textarea = document.getElementById("message");
    if (!textarea) return;

    const resize = () => {
      textarea.style.height = "auto";
      textarea.style.height = textarea.scrollHeight + "px";
    };

    // Remove old listener if any
    textarea.removeEventListener("input", resize);
    textarea.addEventListener("input", resize);

    // Initialize
    resize();
  }

  // Run once on full page load
  document.addEventListener("DOMContentLoaded", initTextareaResize);

  // Run again after Astro swaps the page
  document.addEventListener("astro:page-load", initTextareaResize);

  // Also catch history nav (back/forward)
  window.addEventListener("pageshow", initTextareaResize);
</script>

    </div>
  </main>

  <section class="project-grid" id="grid" data-grid="projects">
  
  <div class="project">
      <div class="titlebox">
        <p>"Titel"</p>
      </div>
      <div class="rectangle-content">
          <p>
        <span class="lang-de">klick:</span>
        <span class="lang-en">click:</span>
      </p>

      <!-- Plain text email (click copies to clipboard; no mailto) -->
      <a id="mail" class="email-text">hi@jannisreinelt.com</a>

      </div>

  </div>



   <div class="contact-card">
      <div class="titlebox">
        <p>"Titel"</p>
      </div>


      <div class="word" >
        <!-- Spacer + 'or' in DE/EN -->
      <p class="spacer">
        <span class="lang-de">oder:</span>
        <span class="lang-en">or:</span>
      </p>

      <!-- Netlify form -->
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p class="sr-only">
          <label>Don’t fill this out: <input name="bot-field" /></label>
        </p>

        <label for="name">
          <span class="lang-de">Name</span>
          <span class="lang-en">Name</span>
        </label>
        <input id="name" name="name" type="text" autocomplete="name" />

        <label for="email">
          <span class="lang-de">E-Mail*</span>
          <span class="lang-en">Email*</span>
        </label>
        <input id="email" name="email" type="email" autocomplete="email" required />

  <label for="message">
          <span class="lang-de">Nachricht</span>
          <span class="lang-en">Message</span>
        </label>
        <textarea id="message" name="message" rows="6" placeholder="..." required></textarea>

        <button type="submit">
          <span class="lang-de">Senden</span>
          <span class="lang-en">Send</span>
        </button>
      </form>

    </div>

  </div>
  </section>

<style>
/* --- Grid --- */
.project-grid {
  position: relative;
  overflow: visible;
  display: grid;
  width: 100%;
  max-width: 100vw;
  box-sizing: border-box;
  --rect-width: 26.1rem;               /* card width */
  grid-template-columns: repeat(auto-fill, var(--rect-width));
  gap: 1rem;
  justify-content: center;
  margin-top: 5rem;
  margin-bottom: 2rem;
  min-height: 70vh;
}
*/
/* Mobile */
@media (max-width: 50em) {
  .project-grid {
    --rect-width: 100%;
    margin-top: 2rem;
    grid-template-columns: 1fr;
    width: 96vw;
  }
}
</BaseLayout>

<style>
  .contact-page {
    display: flex;
    align-items: flex-start; /* 'top' isn't valid; use flex-start */
    justify-content: center;
    margin-top: 5rem;
    min-height: 60vh;
    font-size: var(--font-size-m);
    text-decoration-skip-ink: auto;
    text-underline-offset: 0.08em;
    text-decoration-thickness: from-font;
  }

  .word {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    justify-content: center;
    padding: 1rem;
  }

  .spacer {
    margin-top: 1.5rem; /* extra space before "or:" */
  }

  .email-text {
    user-select: all;
    padding: 0.15rem 0;
    /* border-bottom: 1px dashed var(--border-color); */
    width: fit-content;
  }
  .email-text.copied {
   /* border-bottom-style: ; */
  }

  .word label {
    font-size: var(--font-size-s);
    color: var(--color-text-alt);
    text-decoration: none;
  }

  .word input[type="text"],
  .word input[type="email"] {
    width: 100%;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem;
  }

  .word textarea {
    width: 100%;
    min-height: 10rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem;
    resize: none;          /* JS handles growth */
    overflow: hidden;      /* hide scrollbar */
    transition: height 0.2s ease;
  }

  .word button[type="submit"] {
    align-self: flex-start;
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.8rem;
    margin: 2rem 0rem 3rem 0rem;
    text-decoration: none;
    
  }

  .sr-only {
    position: absolute;
    left: -9999px;
  }
</style>
